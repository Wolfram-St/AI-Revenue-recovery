# =============================================================================
# RecoverAI — Environment Configuration Template
# Copy this file to '.env' and populate with your credentials:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
APP_ENV=development
PORT=8000
DEMO_MODE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# -----------------------------------------------------------------------------
# Razorpay API Credentials (Test or Live Mode)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# -----------------------------------------------------------------------------
# Razorpay Webhook Secret
# Obtain / configure from Razorpay Dashboard -> Settings -> Webhooks
# -----------------------------------------------------------------------------
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# For Docker Compose runs (internal container network):
DATABASE_URL=postgresql://recoverai:recoverai@db:5432/recoverai

# For local standalone runs outside Docker:
# DATABASE_URL=postgresql://recoverai:recoverai@localhost:5433/recoverai

POSTGRES_USER=recoverai
POSTGRES_PASSWORD=recoverai
POSTGRES_DB=recoverai
