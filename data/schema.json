{
  "dataset": "payment_attempts",
  "version": "1.1",
  "synthetic": true,
  "target_rows": 5000,
  "semantics": {
    "decision_time": "Immediately after the failed payment attempt and before any recovery intervention.",
    "point_in_time_features": true,
    "customer_history_snapshot": "Only events known before the current attempt may contribute to historical aggregates."
  },
  "feature_columns": [
    "attempt_id", "payment_id", "customer_id", "amount_inr", "payment_method",
    "attempt_number", "customer_tenure_days", "successful_payment_count",
    "failed_payment_count", "historical_recovery_count", "customer_opted_out",
    "failure_code", "failure_category", "issuer_response", "device_type",
    "country", "fraud_risk"
  ],
  "label_columns": [
    "recovered"
  ],
  "outcome_columns": [
    "recovery_time_hours"
  ],
  "action_aware_columns_reserved_for_optimizer": [
    "recovery_action",
    "action_outcome",
    "recovered_amount_inr"
  ],
  "failure_categories": [
    "temporary_decline",
    "hard_decline",
    "payment_method_issue",
    "authentication_required",
    "unknown"
  ],
  "leakage_policy": {
    "features_must_be_known_at_decision_time": true,
    "label_is_not_a_feature": true,
    "post_intervention_outcomes_are_not_features": true
  }
}
